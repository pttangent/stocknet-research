    "research:model-comparison": "python scripts/build_model_comparison.py",
    "research:build-report": "python scripts/build_experiment_report.py",
    "research:build-consensus": "python scripts/build_consensus_clusters.py",
    "research:train-xgboost": "python scripts/train_xgboost_baseline.py",
    "research:train-tgnn": "python scripts/train_tgnn_snapshot.py",
